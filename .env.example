# iCal feeds (comma-separated webcal/https URLs)
ICAL_URLS=

# Timezone every calendar event is parsed/displayed in (IANA name).
# Floating/all-day iCal times are anchored to this zone, and all calendar UI
# (Master Controller, dashboard widgets, full calendar page) renders in it — so
# times are identical regardless of where the server or browser runs.
# Must be NEXT_PUBLIC_ so client bundles can read it. Defaults to America/New_York.
NEXT_PUBLIC_CALENDAR_TZ=America/New_York

# Supabase — get from supabase.com → project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nutrition API key — generate with: openssl rand -hex 32
LIFE_OS_NUTRITION_API_KEY=

# AI core (Master Controller) — get a key from platform.openai.com → API keys
OPENAI_API_KEY=
# Optional: override the chat model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
